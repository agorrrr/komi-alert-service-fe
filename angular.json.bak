                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Tutor_One:build:production"
            },
            "default": {
              "buildTarget": "Tutor_One:build:default"
            },
            "dev-bni-bank": {
              "buildTarget": "Tutor_One:build:dev-bni-bank"
            },
            "dev-bni-company": {
              "buildTarget": "Tutor_One:build:dev-bni-company"
            },
            "lab-bank": {
              "buildTarget": "Tutor_One:build:dev-lab-bank"
            },
            "lab-company": {
              "buildTarget": "Tutor_One:build:dev-lab-company"
            },
            "lab2-bank": {
              "buildTarget": "Tutor_One:build:dev-lab2-bank"
            },
            "lab2-company": {
              "buildTarget": "Tutor_One:build:dev-lab2-company"
            },
            "lab-tahap2-bank": {
              "buildTarget": "Tutor_One:build:dev-lab-tahap2-bank"
            },
            "lab-tahap2-company": {
              "buildTarget": "Tutor_One:build:dev-lab-tahap2-company"
            },
            "local-bank": {
              "buildTarget": "Tutor_One:build:dev-local-bank"
            },
            "local-company": {
              "buildTarget": "Tutor_One:build:dev-local-company"
            },
            "qa-bni-bank": {
              "buildTarget": "Tutor_One:build:dev-qa-bni-bank"
            },
            "qa-bni-company": {
              "buildTarget": "Tutor_One:build:dev-qa-bni-company"
            },
            "dc1-bni-bank": {
              "buildTarget": "Tutor_One:build:dev-dc1-bni-bank"
            },
            "dc1-bni-company": {
              "buildTarget": "Tutor_One:build:dev-dc1-bni-company"
            },
            "dc2-bni-bank": {
              "buildTarget": "Tutor_One:build:dev-dc2-bni-bank"
            },
            "dc2-bni-company": {
              "buildTarget": "Tutor_One:build:dev-dc2-bni-company"
            },
            "development": {
              "buildTarget": "Tutor_One:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "Tutor_One:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
