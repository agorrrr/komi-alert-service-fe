{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Tutor_One": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/gardafds"
            },
            "index": "src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/primeflex/primeflex.css",
              "src/styles.css"
            ],
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4mb",
                  "maximumError": "5mb"
                }
              ],
              "outputHashing": "all"
            },
            "default": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.ts"
                }
              ]
            },
            "dev-bni-bank": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev-bni-bank.ts"
                }
              ],
              "outputHashing": "all",
              "aot": true
            },
            "dev-bni-company": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev-bni-company.ts"
                }
              ],
              "outputHashing": "all",
              "aot": true
            },
            "lab-bank": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": false,
              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.lab-bank.ts"
                }
              ]
            },
            "lab-company": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": false,
              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.lab-company.ts"
                }
              ]
            },
            "lab2-bank": {
              "optimization": {
                "scripts": true,
                "styles": true,
