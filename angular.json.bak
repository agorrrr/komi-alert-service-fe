              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": false,
              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
