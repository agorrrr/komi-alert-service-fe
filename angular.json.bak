              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local-company.ts"
                }
              ]
            },
            "qa-bni-bank": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": false,
              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa-bni-bank.ts"
                }
              ]
            },
            "qa-bni-company": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": false,
              "outputHashing": "all",
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa-bni-company.ts"
                }
              ]
            },
            "dc2-bni-bank": {
              "optimization": {
                "scripts": true,
                "styles": true,
