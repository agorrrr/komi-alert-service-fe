//################################# PRIMENG WORKAROUND
.p-menuitem-text {
    padding-left: 10px;
    font-size: 0.8rem;
    color: #fff;
}
.p-panel .p-panel-header .p-panel-title {
    font-weight: 500!important;
    padding: 3px 1rem!important;
    font-size: 14px;
}
.p-panel .p-panel-content {
    padding: 1rem!important;
}
.p-panel .p-panel-icons-end {
    margin-left: auto!important;
}
.panel-bg .p-panel .p-panel-header .p-panel-header-icon {
    color: #f5f2f2!important;
}
.panel-bg .p-panel .p-panel-header {
    border: solid 0.01rem #e9e6e6!important;
    color: white!important;
    background-color: #1a97ac!important;

}

.p-panelmenu .p-menuitem-text {
    line-height: 3!important;
}
.p-panelmenu .p-panelmenu-header {
    border-color: transparent!important;
    background: transparent!important;

}
.p-panelmenu .p-panelmenu-header .p-panelmenu-header-content .p-panelmenu-header-action {
    color: #fff;
}
.p-panelmenu .p-panelmenu-header:not(.p-disabled).p-highlight:hover .p-panelmenu-header-content {
    border-color: transparent!important;
    background: transparent!important;

}
.p-panelmenu .p-panelmenu-header .p-panelmenu-header-content {
    border-color: transparent!important;
    background: transparent!important;
}
.p-panelmenu .p-panelmenu-header {
    border-color: transparent!important;
    background: transparent!important;
}
.p-panelmenu .p-panelmenu-header .p-highlight {
    border-color: transparent!important;
    background: transparent!important;
}
.p-panelmenu .p-panelmenu-header:not(.p-disabled).p-highlight .p-panelmenu-header-content {
    border-color: transparent!important;
    background: transparent!important;
}
.p-panelmenu .p-panelmenu-panel .p-panelmenu-content {
    border-radius: 0;
}
.p-panelmenu .p-panelmenu-content {

    border: none;
    background: transparent;
    color: #fff;
}
.p-panelmenu .p-panelmenu-header:not(.p-highlight):not(.p-disabled):hover .p-panelmenu-header-content {
    border-color: transparent!important;
    background: transparent!important;

}

.p-panelmenu .p-panelmenu-content .p-menuitem:not(.p-highlight):not(.p-disabled) > .p-menuitem-content:hover{
    background: #e75f11!important;
    border-radius: 7px;
}


.p-panelmenu .p-panelmenu-content .p-menuitem > .p-menuitem-content .p-menuitem-link .p-menuitem-icon {
    color: #fff;
}
.p-menubarsub{
    display: none!important;
}
.p-menubar .p-menubar-custom, .p-menubar .p-menubar-end {
    margin-left: auto;
    padding: 0.05rem 1.5rem!important;
    align-self: center;
}
.p-menubar .p-menubar-custom, .p-menubar .p-menubar-start {
    margin-right: auto;
    width: 40%;
    align-self: left;
}
.p-menu .p-menuitem:not(.p-highlight):not(.p-disabled) > .p-menuitem-text:hover .p-menuitem-link .p-menuitem-icon, .p-menu .p-menuitem:not(.p-highlight):not(.p-disabled) > .p-menuitem-text:hover .p-menuitem-link .p-menuitem-text {
    color: #898989;
}
.p-menu .p-menuitem > .p-menuitem-content .p-menuitem-link .p-menuitem-text {
    color: #898989;
    margin-right: 0.5rem;
}
.p-menu .p-menuitem > .p-menuitem-content .p-menuitem-link {
    // color: #6c6c6c;
    padding: 0.75rem 1rem!important;
    // -webkit-user-select: none;
    // user-select: none;
}
.p-breadcrumb {
    background: transparent;
    border: none;
    padding: 10px 1px 20px 0;
}
.p-breadcrumb .p-breadcrumb-list li:last-child .p-menuitem-text {
    color: #6c6c6c!important;
}
.p-breadcrumb .p-breadcrumb-list li .p-menuitem-link .p-menuitem-text {
    color: #6c6c6c!important;
}
.p-breadcrumb .p-breadcrumb-list li.p-menuitem-separator {
    margin: 0 0.5rem 0 0.5rem!important;
}
.p-datatable .p-datatable-header {
    background: #1a97ac !important;
    color: #fcfbfb!important;
    font-weight: 400!important;
    border-radius: 6px 6px 0 0!important;
}
.p-datatable .p-datatable-header h1, h2, h3, h4, h5 {
    font-weight: 400!important;
}


.p-datatable .p-datatable-sm .p-datatable-header {
    padding: 0.5rem 0.5rem!important;
}

.p-datatable .p-datatable-thead > tr > th{
    border: 0.9rem solid #515e5d!important;
    border-width: 0 0 2px 0!important;
    //font-size: 13px;
    font-weight: 400!important;
    color: #434141!important;
    padding: 0.5rem 0.5rem!important;
    background: #ffffff!important;
}
.p-datatable.p-datatable-sm .p-datatable-tbody > tr > td {
    padding: 0.15rem 0.2rem!important;
}

.p-input-icon-left > i {
    font-size: 12px!important;
}


.p-input-icon-left > i, .p-input-icon-left > .p-icon-wrapper, .p-input-icon-right > i, .p-input-icon-right > .p-icon-wrapper {
    margin-top: -0.3rem!important;
}
.p-input-icon-left > .p-inputtext {
    padding-left: 1.9rem!important;

    border: 1px solid #e1e1e1!important;
}


.p-button {
    padding: 0.05rem 0.5rem!important;
    //border-color: #1a97ac !important;
}


.p-datatable-sm .btn-header-tbl{
    padding: 0.05rem 0.5rem!important;
    background-color: #fff !important;
    border-color: #1a97ac !important;
    color: #1a97ac;
}

.p-datatable-sm .btn-header-tbl :active{
    padding: 0.05rem 0.5rem!important;
    background-color: #fff !important;
    border-color: #1a97ac !important;
    color: #1a97ac;
}

