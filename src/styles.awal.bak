@import "primeng/resources/themes/viva-light/theme.css";
@import "primeng/resources/primeng.css";
@import "primeicons/primeicons.css";
// @import '~quill/dist/quill.snow.css';


* {
    margin: 0;
    padding: 0;
    font-family: var(--font-family);
}
body {
    min-height: 100vh;
    background: #f5f4f4;
    display: flex;
    overflow: hidden;
}

.articlef {
    padding: 0!important;
    margin: 0!important;
    font-size: 0.8rem;
    color: rgb(95, 95, 95)!important;
}
.labelf {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(29, 29, 29)!important;
}
//################################ SIDBAR LAYOUT ######################
::-webkit-scrollbar {
    width: 5px;
}
::-webkit-scrollbar-thumb {
    background: #fff;
    color: #fff;
    border-radius: 10px;
}
// .sidebar {
//     position: fixed;
//     top: 0;left: 0;
//     width: 250px;height: 100%;
//     background: linear-gradient(-45deg, #030244, #1e84e4);
//     display: flex;
//     flex-direction: column;
// }
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 100%;
    background: linear-gradient(-85deg, #006677, #006677);
    display: flex;
    flex-direction: column;
}
header {
    min-height: 50px;
    text-align: center;
    // background: #030244;
}
header h2 {
    font-size: 24px;
    font-weight: 400;
    color: #fff;
    padding-top: 10px;
}
footer {
    padding: 0;
    margin: 0;
    min-height: 40px;
    text-align: center;
}
footer h2 {
    font-size: 24px;
    font-weight: 400;
    color: #fff;
    padding:0;
    margin: 0;
}

.col-4
{
  padding: 0 !important;
}
.scrollbox{
    overflow: auto;
    visibility: hidden;
}
.scrollbox-inner p {
    font-size: 0.8rem;
    color: #fff;

}
.scrollbox-inner, .scrollbox:hover {
    visibility: visible;
}
.articleContent p {
    color: #030244!important;
}
.header {
    min-height: 50px;
    background: #fff;
    // background: #030244;
}
.header h2 {
    font-size: 24px;
    font-weight: 400;
    padding-top: 10px;
}
.header-text-only {
    margin: 0;
    padding: 0;
    background: transparent;
    font-size: 24px!important;
    font-weight: 400
}

.caption-text-only {
    margin: 0;
    padding: 0;
    background: transparent;
    color: #030244!important;
    font-size: 14px!important;
    font-weight: 400
}

.sbcontain {
    position: fixed;
    // left: 250px;
    // width: calc(100% - 250px);
    height: 100%;
    display: flex;
    flex-direction: column;
}
.sbpadding {
    padding: 15px 15px 0 15px;
}
// .mobilemenubtn {
//     display: none;
// }
