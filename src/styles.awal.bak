.align-items-center {
    align-items: center !important;
    color: #6c757d;
  }
.p-paginator {
    border: 0!important;
    border-width: 0!important;
    padding: 0.5rem 1rem!important;

}
.p-paginator .p-paginator-first, .p-paginator .p-paginator-prev, .p-paginator .p-paginator-next, .p-paginator .p-paginator-last {
    background-color: transparent;
    border: 0 none;
    color: #898989;
    min-width: 1.557rem!important;
    height: 2.857rem;
    margin: 0.143rem;
    transition: box-shadow 0.3s;
    border-radius: 6px;
}
.p-link {
    font-size: 0.8rem!important;
    border-radius: 6px;
}


.field-checkbox, .field-radiobutton {
    display: inline-block !important;
    margin-top: 1rem;
    margin-right: 1rem;
}

.p-autocomplete-panel .p-autocomplete-items .p-autocomplete-item {
    margin: 0 0 4px 0;
    padding: 0.5rem 1rem;
  }

.custom-textarea {
    color: #6c757d;
    font-size: 12px;
}

.custom-dropdown {
    width: 115px;
}

.p-button-close
{
    color: #ffffff;
    background: #105b67;
    border: 2px solid #105b67;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s, box-shadow 0.3s;
    border-radius: 6px;
  }


.button-link-active {
    background: none;
    border: none;
    color: #e75f11;
    border-radius: 7px;
    text-decoration: underline;
    cursor: pointer;
}


.button-link {
    background: none;
    border: none;
    color: #6c757d;
    text-decoration: underline;
    cursor: pointer;
}

.custom-tag{
	padding-left: 1rem !important;
	padding-right: 1rem !important;
}

.p-panelmenu .p-panelmenu-content .p-menuitem > .p-menuitem-content .p-menuitem-link .p-submenu-icon
{
    color: #fff;
  }

li p-panelmenusub .p-menuitem-link .ng-star-inserted{
    padding-left: 1rem;
}

.fieldset-custom{
    padding: 2rem !important;
}

.align-right {
    text-align: right;
  }


.ui-tooltip {
    background-color: #333;
    color: #fff;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #666;
}

/* Optional: Change the arrow color */
.ui-tooltip-arrow {
    border-color: #17043b transparent transparent transparent;
}

.min-h-screen-unauthorized {
    min-height: 100vh !important;
    min-width: 100rem; /* You can adjust this value as needed */
    margin: 0 auto; /* This will horizontally center the content */
}



::ng-deep .ui-datepicker {
    z-index: 1; /* Atur z-index sesuai kebutuhan Anda */
}

.p-datepicker-calendar-container .p-disabled {
    background-color: #dfdfdf;
}

.p-datepicker-calendar-container .p-disabled {
    background-color: #dfdfdf;
}

.password-weak{
    padding-top: 1rem;
    font-size: 12px;
    color:red;
}

.p-datatable-gridlines{
    margin-bottom: 6rem;
}

.custom-marker {
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    border-radius: 50%;
    z-index: 1;
}

.p-tooltip {
    display: none !important;
}

.merapi-button-secondary {
    background-color: #fff !important;
    border-color: #1a97ac !important;
    color: #1a97ac;
}

/* Hide pTooltip using ID */
#myTooltip {
    display: none !important;
}

::ng-deep {
    .p-timeline-event-content,
    .p-timeline-event-opposite {
        line-height: 1;
    }
}

textarea {
    border: 2px solid #e1e1e1;
    padding-left: 5px;
    border-radius: 25px;
    // opacity($color: 50%)
    // background-color: blue;
  }
  textarea:enabled:hover {
    border-color: #cecece;
  }
  textarea:focus { 
    outline: none !important;
    border-color: #719ECE;
    box-shadow: 0 0 10px #719ECE;
  }
  
  


@media screen and (max-width: 960px) {
    ::ng-deep {
        .customized-timeline {
            .p-timeline-event:nth-child(even) {
                flex-direction: row !important;

                .p-timeline-event-content {
                    text-align: left !important;
                }
            }

            .p-timeline-event-opposite {
                flex: 0;
            }

            .p-card {
                margin-top: 1rem;
            }
        }
    }
}


// target mobile devices
@media only screen and (max-device-width: 480px) {

//######################## PRIME NG #################
.p-menubar {
    padding: 0.05rem 0.5rem!important;
}
//####################################################
    .sidebar {
        display: none;
    }
    .sbcontain {
        left: 0;
        width: calc(100%);

    }
    .mobilemenubtn {
        display:inline;
    }
}

