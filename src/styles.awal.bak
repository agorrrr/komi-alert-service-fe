}
.custom-card .p-card .p-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #105b67;
    padding-left: 1rem;
    padding-top: 0.5rem;
    padding-right: 1rem;
}

.custom-card .p-card .p-card-subtitle {
    font-weight: 400;
    color: #105b67;

    padding-left: 1rem;
    padding-right: 1rem;
}

.custom-card .p-card .p-card-content {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 1rem;
}

